{
  "expo": {
    "name": "Sinara Soon",
    "slug": "pos-kospin",
    "version": "1.0.7",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_icon_mobile_300.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/logo_mobile_300.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F7900"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Aplikasi memerlukan akses galeri untuk menyimpan gambar QRIS setoran.",
        "NSPhotoLibraryUsageDescription": "Aplikasi memerlukan akses galeri untuk menyimpan gambar QRIS setoran."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_mobile_1024.png",
        "backgroundColor": "#1F7900"
      },
      "package": "com.abunda.poskospin",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_mobile_300.png",
          "imageWidth": 100,
          "backgroundColor": "#1F7900",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "audioPermission": "Aplikasi memerlukan akses audio.",
          "photosPermission": "Aplikasi memerlukan akses galeri untuk menyimpan gambar QRIS setoran.",
          "savePhotosPermission": "Aplikasi memerlukan akses galeri untuk menyimpan gambar QRIS setoran.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0cfb8075-db1d-4a85-a096-b29d6d2f4aca"
      }
    },
    "owner": "abunda"
  }
}
